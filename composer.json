{
    "name": "a1ekas/demo-php-app",
    "description": "A demo PHP application",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-pdo": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "phpunit/phpcov": "^11.0",
        "psalm/phar": "^6.13",
        "rector/rector": "^2.2",
        "infection/infection": "^0.31",
        "friendsofphp/php-cs-fixer": "^3.91"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/",
            "App\\Rector\\": ".rector/src/"
        }
    },
    "config": {
        "platform": {
            "php": "8.4"
        },
        "bin-dir": "bin/",
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        },
        "process-timeout": 0
    },
    "scripts": {
        "csfixer-lint": [
            "bin/php-cs-fixer fix --dry-run -vv --config=.php-cs-fixer.dist.php --cache-file=.php-cs-fix-src.cache ./.rector",
            "bin/php-cs-fixer fix --dry-run -vv --config=.php-cs-fixer.dist.php --cache-file=.php-cs-fix-src.cache ./config",
            "bin/php-cs-fixer fix --dry-run -vv --config=.php-cs-fixer.dist.php --cache-file=.php-cs-fix-src.cache ./public",
            "bin/php-cs-fixer fix --dry-run -vv --config=.php-cs-fixer.dist.php --cache-file=.php-cs-fix-src.cache ./src"
        ],
        "csfixer-fix": [
            "bin/php-cs-fixer fix -v --config=.php-cs-fixer.dist.php --cache-file=.php-cs-fix-src.cache ./.rector",
            "bin/php-cs-fixer fix -v --config=.php-cs-fixer.dist.php --cache-file=.php-cs-fix-src.cache ./config",
            "bin/php-cs-fixer fix -v --config=.php-cs-fixer.dist.php --cache-file=.php-cs-fix-src.cache ./public",
            "bin/php-cs-fixer fix -v --config=.php-cs-fixer.dist.php --cache-file=.php-cs-fix-src.cache ./src"
        ]
    }
}
